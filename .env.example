NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Dashboard auth. Generate both with: node scripts/hash-password.mjs
# Base64-encoded bcrypt hash of the dashboard password (never the password itself).
DASHBOARD_PASSWORD_HASH=
# 32+ random characters. Changing it signs every dashboard session out.
SESSION_SECRET=

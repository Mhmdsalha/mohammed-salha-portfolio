{
  "name": "mohammed-salha-portfolio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/check-build.mjs",
    "start": "next start",
    "lint": "eslint --max-warnings=0 && node scripts/design-tokens.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "e2e": "playwright test --project=e2e",
    "e2e:baseline": "node scripts/capture-baseline.mjs",
    "db:types": "node scripts/gen-db-types.mjs"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx}": [
      "eslint --max-warnings=0 --no-warn-ignored --fix",
      "prettier --write"
    ],
    "*.{json,css,md,yml,yaml}": "prettier --write"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.0.1",
    "@supabase/supabase-js": "^2.45.4",
    "@vercel/speed-insights": "^2.1.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "jose": "^6.2.18",
    "lucide-react": "^0.468.0",
    "next": "^15.3.0",
    "next-intl": "^3.26.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.55.0",
    "server-only": "^0.0.1",
    "sharp": "^0.34.5",
    "sonner": "^1.7.4",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@electric-sql/pglite": "^0.5.17",
    "@eslint/eslintrc": "^3.2.0",
    "@formatjs/icu-messageformat-parser": "^2.11.4",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.3.0",
    "husky": "^9.1.7",
    "intl-messageformat": "^10.7.18",
    "lint-staged": "^16.4.0",
    "postcss": "^8.4.49",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vitest": "^5.1.1"
  }
}
